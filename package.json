{
  "name": "bare-arti",
  "version": "0.0.1",
  "description": "Embedded Arti (Rust Tor) as a bundled SOCKS5 proxy for the dht-relay-tor stack — no external tor daemon",
  "main": "index.js",
  "addon": true,
  "private": true,
  "files": [
    "index.js",
    "lib/**/*.js",
    "binding.c",
    "binding.js",
    "addon/Cargo.toml",
    "addon/Cargo.lock",
    "addon/src/**/*.rs",
    "src/**/*.rs",
    "Cargo.toml",
    "Cargo.lock",
    "CMakeLists.txt",
    "scripts/verify-package-prebuilds.js"
  ],
  "scripts": {
    "format": "prettier --write .",
    "verify": "cargo build --bin arti-socks && node test/launcher.js",
    "build:addon": "bare-make generate && bare-make build && bare-make install",
    "build:sidecar": "cargo build --release --bin arti-socks",
    "prepack": "node scripts/verify-package-prebuilds.js",
    "assemble:package": "node scripts/assemble-package.js",
    "assemble:proof": "node scripts/assemble-proof-package.js",
    "test": "prettier --check . && node test/all.js",
    "test:addon": "bare test/addon.js"
  },
  "dependencies": {
    "which-runtime": "^1.3.2"
  },
  "optionalDependencies": {
    "bare-env": "^3.0.0",
    "bare-fs": "^4.0.0",
    "bare-path": "^3.0.0",
    "bare-subprocess": "^5.0.0"
  },
  "devDependencies": {
    "bare-make": "1.6.3",
    "bare-runtime": "^1.30.3",
    "bare-worker": "^4.4.0",
    "brittle": "^3.0.0",
    "cmake-bare": "^1.1.2",
    "cmake-cargo": "^0.0.4",
    "prettier": "^3.6.2",
    "prettier-config-holepunch": "^2.0.0"
  },
  "prettier": "prettier-config-holepunch",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ayooooo123/bare-arti.git"
  },
  "bugs": {
    "url": "https://github.com/ayooooo123/bare-arti/issues"
  },
  "homepage": "https://github.com/ayooooo123/bare-arti#readme",
  "license": "MIT"
}
